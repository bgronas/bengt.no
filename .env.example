# Copy to .env for local use only. .env is ignored by Git and must never be committed.
# In GitHub Actions these values come from repository secrets and variables instead
# (Settings > Secrets and variables > Actions). See docs/dns-and-pages.md.

# Required only for enrich, translate and social commands. Leave empty otherwise.
ANTHROPIC_API_KEY=

# Optional. Overrides api.default_model in data/automation-policy.yaml.
ANTHROPIC_MODEL=
